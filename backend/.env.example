QA_APP_ENV=local
QA_DATABASE_URL=postgresql+psycopg://quote:quote@127.0.0.1:5432/quote_assistant
QA_SEED_DEMO_DATA=true
QA_OBJECT_STORE_BACKEND=local
QA_LOCAL_OBJECT_DIR=/tmp/quote-assistant-objects
QA_OBJECT_SIGN_SECRET=change-me-object-sign
QA_SIGNED_URL_TTL_SECONDS=300
QA_EXTRACTION_ENGINE=fixture

# 生产必须 QA_APP_ENV=production，并改 QA_EXTRACTION_ENGINE=vendor。
# 非本地环境禁止 fixture：文件名不得触发预置假提取结果。

# 生产改为 oss，并保证 Bucket 关闭公共读、默认服务端加密
# QA_OBJECT_STORE_BACKEND=oss
# QA_OSS_ACCESS_KEY_ID=
# QA_OSS_ACCESS_KEY_SECRET=
# QA_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# QA_OSS_BUCKET=
